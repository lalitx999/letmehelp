# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env)
SECRET_KEY=change-me
ALLOWED_HOSTS=letmehelp.com,www.letmehelp.com
CSRF_TRUSTED_ORIGINS=https://letmehelp.com,https://www.letmehelp.com
SITE_URL=https://letmehelp.com
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/letmehelp
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# อีเมล (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Let Me Help <no-reply@letmehelp.com>

# บัญชีรับเงิน + EasySlip
PROMPTPAY_ID=
PROMPTPAY_ACCOUNT_NAME=
EASYSLIP_API_KEY=

# Telegram Bot (แจ้งเตือนแอดมิน) — chat id หลายคนคั่นด้วยจุลภาค
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ฟอนต์ไทยสำหรับ PDF (ไฟล์ .ttf)
PDF_FONT_PATH=

# แชทบอท (เว้นว่าง = ใช้บอทกติกา ไม่เรียก AI)
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-opus-5-5
CHATBOT_EFFORT=low
CHATBOT_FALLBACK_MODEL=claude-opus-4-8
# โซเชียลมีเดียใน Footer (มีค่าตั้งต้นในโค้ดแล้ว ใส่ที่นี่เพื่อเปลี่ยน หรือแก้ในหลังบ้าน)
SOCIAL_TIKTOK=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
# ลิงก์ LINE ส่วนตัวสำหรับให้นักเรียนทักถามก่อนซื้อ
LINE_CONTACT_URL=
